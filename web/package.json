{
  "name": "mio-ru",
  "private": true,
  "type": "module",
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "eslint": "^10.12.0",
    "prettier": "^3.6.0",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  },
  "version": "2.0.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "format": "prettier --write src tests docs *.json *.js *.md index.html",
    "format:check": "prettier --check src tests docs *.json *.js *.md index.html",
    "check": "npm run lint && npm run test && npm run build",
    "lint": "eslint src"
  }
}
