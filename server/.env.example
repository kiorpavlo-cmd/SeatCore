HOST=127.0.0.1
PORT=4175
DATABASE_PATH=data/mio.sqlite
WEB_DIST=../web/dist

# Google Business Profile: see docs/GOOGLE.md. Keep secrets on the server.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:4175/api/v1/google/callback
# Generate once: node -e 'console.log(require("node:crypto").randomBytes(32).toString("hex"))'
MIO_GOOGLE_TOKEN_KEY=

# Viber Business Messages by phone through Infobip: docs/VIBER.md.
INFOBIP_BASE_URL=
INFOBIP_API_KEY=
VIBER_INFOBIP_SENDER=
VIBER_INFOBIP_ACCEPTED_TEMPLATE=
VIBER_INFOBIP_CANCELLED_TEMPLATE=
VIBER_INFOBIP_LANGUAGE=ru
