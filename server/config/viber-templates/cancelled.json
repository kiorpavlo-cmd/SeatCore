{
  "category": "TRANSACTIONAL",
  "body": [
    {
      "language": "ru",
      "template": "Здравствуйте, {{name}}! Ваше бронирование в {{restaurant}} на {{date}} в {{time}} отменено. Если это ошибка, свяжитесь с рестораном: {{phone}}."
    }
  ],
  "params": [
    {
      "type": "TEXT",
