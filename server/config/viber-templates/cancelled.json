      "example": "Mio"
    },
    {
      "type": "TEXT",
      "name": "date",
      "example": "14.10.2026"
    },
    {
      "type": "TEXT",
      "name": "time",
      "example": "19:00"
    },
    {
      "type": "TEXT",
      "name": "phone",
      "example": "+37060000123"
    }
  ]
}
